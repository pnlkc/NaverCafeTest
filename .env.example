# ============================================================
#  네이버 카페 자동 관리 통합 시스템 - 환경 변수 템플릿 (.env.example)
#  본 파일을 복사하여 .env 로 변경 후 본인의 설정값을 입력하세요.
# ============================================================

# [1. 네이버 카페 기본 설정]
# [필수] 카페 클럽 ID (카페 주소창 또는 모바일 주소의 숫자 ID)
NAVER_CAFE_CLUB_ID=

# [선택] 카페 메인 URL (대시보드 바로가기용)
NAVER_CAFE_URL=


# [2. AI 기사 요약 API 키 설정]
# [선택] OpenRouter API 키 (무료 LLM 뉴스 요약 연동)
OPENROUTER_API_KEY=

# [선택] Gemini API 키 (Google AI Studio)
GEMINI_API_KEY=


# [3. 디스코드 알림 Webhook URL 설정]
# [선택] 통합 기본 디스코드 웹훅 URL (아래 개별 전용 웹훅 설정 시 비워두어도 됨)
DISCORD_WEBHOOK_URL=

# [선택] 신고 게시판 모니터링 전용 디스코드 웹훅 URL
DISCORD_REPORT_WEBHOOK_URL=

# [선택] 건의 사항 게시판 모니터링 전용 디스코드 웹훅 URL
DISCORD_SUGGESTION_WEBHOOK_URL=

# [선택] 자동 작업 처리 로그 전용 디스코드 웹훅 URL
DISCORD_LOG_WEBHOOK_URL=


# [4. 게시판 ID 및 메뉴명 설정]
# [필수] 뉴스 기사 자동 포스팅 게시판 ID (search.menuid=숫자)
PUBLISH_BOARD_ID=

# [선택] 1회 수집/발행할 최대 뉴스 기사 개수 (기본값: 10)
NEWS_MAX_ARTICLES_PER_RUN=10

# [선택] 등업 검증용 가입인사 게시판 이름 (기본값: 등업 게시판)
WELCOME_BOARD_NAME=등업 게시판

# [선택] 모니터링할 신고 게시판 이름 (기본값: 신고 게시판)
REPORT_BOARD_NAME=신고 게시판

# [선택] 모니터링할 건의 사항 게시판 이름 (기본값: 자유 게시판)
SUGGESTION_BOARD_NAME=자유 게시판

# [선택] 수동 지정용 신고 게시판 ID
REPORT_BOARD_ID=

# [선택] 수동 지정용 건의 게시판 ID
SUGGESTION_BOARD_ID=


# [5. 스케줄러 실행 주기 설정 (초 단위, 선택)]
# [선택] 가입 자동 승인 확인 주기 (초 단위, 기본값: 60)
INTERVAL_JOIN_APPROVE=60

# [선택] 회원 조건 자동 등업 주기 (초 단위, 기본값: 300)
INTERVAL_LEVEL_UP=300

# [선택] 신고 게시판 실시간 감시 주기 (초 단위, 기본값: 60)
INTERVAL_REPORT_ALERT=60

# [선택] 건의 사항 실시간 감시 주기 (초 단위, 기본값: 300)
INTERVAL_SUGGESTION_ALERT=300

# [선택] 뉴스 기사 수집 및 자동 포스팅 주기 (초 단위, 기본값: 86400 = 24시간)
INTERVAL_NEWS_PUBLISH=86400
